# =============================================================================
# InterSight -- deploy environment variables template
# Copy to .env.deploy, fill in real values. Never commit to git.
# =============================================================================

# -- Service account -----------------------------------------------------------
DEPLOY_SA_EMAIL=your-sa@ads-bpd-guard-sandbox.iam.gserviceaccount.com

# -- GCP / deploy target -------------------------------------------------------
GCP_PROJECT_DEPLOY=ads-bpd-guard-sandbox
REGION=asia-northeast1
GOOGLE_CLOUD_PROJECT=ads-bpd-guard-sandbox
INCEPT_ASSET_BUCKET=your-incept-assets-bucket-name
INCEPT_REQUIRE_GCS_UPLOAD=false
VERTEX_VEO_FAST_MODEL=veo-3.1-fast-generate-001
VERTEX_VEO_LOCATION=us-central1
VERTEX_VEO_MODEL=
VERTEX_PLAYABLE_MODEL=gemini-3.6-flash
VERTEX_VIDEO_ANALYSIS_MODEL=gemini-3.6-flash
VERTEX_LYRIA_ENABLED=true
VERTEX_LYRIA_MODEL=lyria-3-clip-preview
VERTEX_LYRIA_LOCATION=global
# Shared image + video budget per user.
STUDIO_USER_BUDGET_USD=500
# Veo 3.1 Fast video-only baseline. The app adds $0.02/s for 1080p.
VEO_FAST_ESTIMATED_COST_PER_SECOND_USD=0.08
# Build-time only: a prepared local Creative Core copied into the API image.
# This path is never passed to Cloud Run at runtime.
CREATIVE_CORE_BUILD_CONTEXT=/Users/owen.geng/.moloco/cr-agent/creative-core

# Service runtime must have permission to read/write the bucket above.
# Uploads, generated images, and GIF assets are stored there for Studio.
# Set INCEPT_REQUIRE_GCS_UPLOAD=true only after the Cloud Run service account
# definitely has working write access to the bucket above.

# -- BigQuery ------------------------------------------------------------------
BQ_WRITE_PROJECT=ads-bpd-guard-sandbox
BQ_READ_PROJECT=your-bq-data-project-here
GCP_PROJECT_DATA=your-bq-data-project-here
BQ_DATASET_SUPPLY_SMB_WRITE=Incept
BQ_DATASET_CONFIG=Incept
BIGQUERY_DATASET=Incept
BIGQUERY_ENABLED=true

# -- Shared internal API key (same value for api + web) -----------------------
INCEPT_INTERNAL_API_KEY=your-random-secret-key-here
INCEPT_ADMIN_EMAILS=owen.geng@moloco.com

# -- Google OAuth (web) --------------------------------------------------------
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# -- NextAuth (web) ------------------------------------------------------------
AUTH_SECRET=run-openssl-rand-base64-32-to-generate
# deploy.sh auto-updates this after first web deploy (to CUSTOM_DOMAIN if set, else the .run.app URL)
NEXTAUTH_URL=https://placeholder.example.com

# -- Custom domain (optional) ---------------------------------------------------
# If you've mapped a custom domain to the Cloud Run web service (e.g. via
# `gcloud run domain-mappings create`), set it here so deploy.sh uses it for
# NEXTAUTH_URL / CORS instead of the raw .run.app URL. Without this, every
# deploy resets auth redirects back to the .run.app address.
# CUSTOM_DOMAIN=https://linglonglab.moloco.cloud

# =============================================================================
# LinglongLab -- deploy environment variables template
# Copy to .env.deploy, fill in real values. Never commit to git.
# =============================================================================

# -- Service account -----------------------------------------------------------
DEPLOY_SA_EMAIL=your-sa@ads-bpd-guard-sandbox.iam.gserviceaccount.com

# -- GCP / deploy target -------------------------------------------------------
GCP_PROJECT_DEPLOY=ads-bpd-guard-sandbox
REGION=asia-northeast1
# `cloud-build` avoids local Docker Hub network failures; `local` uses Docker Desktop.
BUILD_BACKEND=cloud-build
GOOGLE_CLOUD_PROJECT=ads-bpd-guard-sandbox
# The reviewed release publishes the unified Image + Video product only.
PRODUCT_RELEASE_PROFILE=image-video
INCEPT_ENABLE_GAMING_PLAYABLE=false
INCEPT_ASSET_BUCKET=your-incept-assets-bucket-name
# Optional: defaults to INCEPT_ASSET_BUCKET and stores Video data under
# /video-studio inside the mounted bucket.
VIDEO_STUDIO_BUCKET=
# Cloud SQL: use the existing JSON connection secret; do not put its value here.
CLOUD_SQL_INSTANCE_CONNECTION_NAME=your-project:your-region:your-instance
DATABASE_CONFIG_SECRET=your-cloud-sql-connection-secret
DATABASE_CONFIG_SECRET_VERSION=1
# The internal API key is a separate Secret Manager secret shared by web and API.
INCEPT_INTERNAL_API_KEY_SECRET=incept-internal-api-key
INCEPT_INTERNAL_API_KEY_SECRET_VERSION=1
GOOGLE_CLIENT_SECRET_SECRET=incept-google-client-secret
GOOGLE_CLIENT_SECRET_SECRET_VERSION=1
AUTH_SECRET_SECRET=incept-auth-secret
AUTH_SECRET_SECRET_VERSION=1
# Optional: omit both fields to disable OpenAI-backed providers.
OPENAI_API_KEY_SECRET=
OPENAI_API_KEY_SECRET_VERSION=

# Anthropic key is injected into Cloud Run from Secret Manager.
# Optional: omit both fields to disable Anthropic-backed providers.
ANTHROPIC_API_KEY_SECRET=
ANTHROPIC_API_KEY_SECRET_VERSION=

# deploy.sh grants the runtime service account `roles/storage.objectUser` on
# the bucket above. Uploads, generated images, and GIF assets are stored there.
# Production uses GCS rather than the container's temporary filesystem.
INCEPT_REQUIRE_GCS_UPLOAD=true

# -- BigQuery ------------------------------------------------------------------
BQ_WRITE_PROJECT=ads-bpd-guard-sandbox
BQ_READ_PROJECT=your-bq-data-project-here
GCP_PROJECT_DATA=your-bq-data-project-here
# Legacy production dataset names are retained to preserve existing data.
BQ_DATASET_APP_WRITE=Incept
BQ_DATASET_CONFIG=Incept
BIGQUERY_DATASET=Incept
BIGQUERY_ENABLED=true

# -- Shared internal API key ---------------------------------------------------
# Managed through INCEPT_INTERNAL_API_KEY_SECRET above; do not store its value here.
INCEPT_ADMIN_EMAILS=owen.geng@moloco.com

# -- Google OAuth (web) --------------------------------------------------------
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# Stored in GOOGLE_CLIENT_SECRET_SECRET; do not put the value here.

# -- NextAuth (web) ------------------------------------------------------------
# Stored in AUTH_SECRET_SECRET; do not put the value here.
# deploy.sh auto-updates this after first web deploy (to CUSTOM_DOMAIN if set, else the .run.app URL)
NEXTAUTH_URL=https://placeholder.example.com

# -- Custom domain (optional) ---------------------------------------------------
# If you've mapped a custom domain to the Cloud Run web service (e.g. via
# `gcloud run domain-mappings create`), set it here so deploy.sh uses it for
# NEXTAUTH_URL / CORS instead of the raw .run.app URL. Without this, every
# deploy resets auth redirects back to the .run.app address.
# CUSTOM_DOMAIN=https://linglonglab.moloco.cloud

# =============================================================================
# NBSpark Incept API -- Cloud Run Dockerfile
# Build context: repo root  (docker build -f Dockerfile.incept-api .)
# =============================================================================
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gcc libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY apps/incept-api/pyproject.toml ./

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir uv \
    && uv pip install --system --no-cache-dir fastapi uvicorn google-auth google-cloud-bigquery \
       google-genai openai pillow python-multipart rembg pydantic

COPY apps/incept-api/app/ ./app/

ENV PYTHONUNBUFFERED=1
ENV PORT=8080

EXPOSE 8080

CMD ["sh", "-c", "python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]

# =============================================================================
# Linglong Lab API — Image + AI Video Cloud Run release profile
#
# This deliberately omits Creative Core, Chromium and the Gaming Playable
# runtime. The deferred product source remains in git; it is simply not needed
# to run the public Image + AI Video release.
# =============================================================================
FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-noto-core \
    fonts-noto-cjk \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY apps/api/app/ ./app/
COPY apps/api/scripts/migrate_sqlite_to_postgres.py ./scripts/migrate_sqlite_to_postgres.py
COPY apps/api/scripts/init_ai_video_schema.py ./scripts/init_ai_video_schema.py

# SQL query files and Kakao assets remain required by the Image product.
COPY sql/ ./sql/
COPY apps/web/public/SpoqaHanSansNeo_all/SpoqaHanSansNeo_TTF_original/ ./fonts/kakao/
COPY apps/web/public/kakao-bizboard-template.png ./fonts/kakao/kakao-bizboard-template.png

ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV INCEPT_PROJECT_ROOT=/app
ENV KAKAO_FONT_DIR=/app/fonts/kakao
ENV KAKAO_TEMPLATE_PATH=/app/fonts/kakao/kakao-bizboard-template.png

EXPOSE 8080

CMD ["sh", "-c", "python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]

# Copy to .env and fill in values.
# FastAPI dev server loads .env automatically via python-dotenv.

# ─────────────────────────────────────────────
# OpenAI (for provider=openai)
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────
# Vertex AI Imagen (for provider=gemini)
# Requires Application Default Credentials:
#   gcloud auth application-default login
# Or run the helper script:
#   bash <(curl -sSL https://storage.googleapis.com/cloud-samples-data/adc/setup_adc.sh)
# ─────────────────────────────────────────────
VERTEX_AI_ENABLED=true
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Model options: imagen-3.0-generate-002 | imagen-3.0-fast-generate-001 | imagen-4.0-generate-001
VERTEX_IMAGEN_MODEL=imagen-4.0-generate-001
VERTEX_IMAGEN_EDIT_MODEL=imagen-3.0-capability-001

# ─────────────────────────────────────────────
# Auth (leave as dev for local)
# ─────────────────────────────────────────────
AUTH_MODE=dev
INCEPT_ENV=development
ALLOWED_EMAIL_DOMAIN=moloco.com

# Role assignment (comma-separated emails)
INCEPT_ADMIN_EMAILS=you@moloco.com
INCEPT_MANAGER_EMAILS=you@moloco.com

# ─────────────────────────────────────────────
# BigQuery / GCS (optional for local dev)
# ─────────────────────────────────────────────
# INCEPT_ASSET_BUCKET=incept-assets
# BIGQUERY_ENABLED=false
# BIGQUERY_DATASET=incept
# BIGQUERY_TABLE_PREFIX=ll_

# ─────────────────────────────────────────────
# Provider config
# ─────────────────────────────────────────────
DEFAULT_IMAGE_PROVIDER=gemini
OPENAI_IMAGE_MODEL=dall-e-3
MAX_IMAGE_VARIANTS=2
MAX_OUTPUT_SIZES=6

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
# Fast multi-size draft path:
# Generate one structured contact sheet, split panels into requested sizes,
# and fall back to per-size generation if panel detection fails.
INCEPT_ENABLE_CONTACT_SHEET_SPLIT=false
INCEPT_ENABLE_MULTI_SIZE_RENDERER=false
INCEPT_CONTACT_SHEET_FALLBACK=false

CORS_ORIGINS=http://localhost:3000

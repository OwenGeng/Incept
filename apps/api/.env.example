# -----------------------------------------------------------------------------
# apps/api (FastAPI)
# -----------------------------------------------------------------------------
INCEPT_ENV=development
INCEPT_API_MODE=live
INCEPT_API_HOST=0.0.0.0
INCEPT_API_PORT=8000
INCEPT_INTERNAL_API_KEY=replace-with-a-shared-internal-api-key
# Shared by the integrated LinglongLab web/API services.
# Video uses the existing Vertex model IDs and locations below.
INCEPT_ADMIN_EMAILS=owen.geng@moloco.com
CORS_ALLOW_ORIGINS=http://localhost:3000

# GCP / BigQuery
GCP_PROJECT_DEPLOY=ads-bpd-guard-sandbox
GCP_PROJECT_DATA=ads-bpd-guard-china
BQ_WRITE_PROJECT=ads-bpd-guard-sandbox
BQ_READ_PROJECT=ads-bpd-guard-china
# Legacy production dataset names are retained to preserve existing data.
BQ_DATASET_APP_WRITE=Incept
BQ_DATASET_CONFIG=Incept
BIGQUERY_DATASET=Incept
GOOGLE_APPLICATION_CREDENTIALS=

# Google Cloud project shared by BigQuery and Vertex AI
GOOGLE_CLOUD_PROJECT=ads-bpd-guard-sandbox

# Vertex AI / Gemini
# GCP_PROJECT_ID falls back to GOOGLE_CLOUD_PROJECT if unset
# GCP_LOCATION defaults to global if unset
INCEPT_ASSET_BUCKET=
INCEPT_REQUIRE_GCS_UPLOAD=false
VERTEX_GEMINI_ENABLED=true
VERTEX_GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
VERTEX_GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-image
VERTEX_GEMINI_MODEL=gemini-3.8-flash
VERTEX_PLAYABLE_MODEL=gemini-3.8-flash
VERTEX_PLAYABLE_FLASH_MODEL=gemini-3.8-flash
VERTEX_PLAYABLE_PRO_MODEL=gemini-3.1-pro-preview
# Used by Image to Video, Video to Video, and Video to Playable planning conversations.
VERTEX_VIDEO_ANALYSIS_MODEL=gemini-3.8-flash
VERTEX_VEO_FAST_MODEL=gemini-omni-1.1-flash-preview
VERTEX_VEO_LOCATION=global
# Optional soundtrack generation for the Video workspace.
VERTEX_LYRIA_ENABLED=true
VERTEX_LYRIA_MODEL=lyria-3-clip-preview
VERTEX_LYRIA_LOCATION=global
VERTEX_VEO_MODEL=
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
# Create this key in the Anthropic Console. Keep it server-side only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Shared image + video budget per user.
STUDIO_USER_BUDGET_USD=500
# Veo 3.1 Fast video-only baseline. The app adds $0.02/s for 1080p.
VEO_FAST_ESTIMATED_COST_PER_SECOND_USD=0.08
# Local Creative Core installation used for true browser capture of uploaded playables.
CREATIVE_CORE_HOME=
PLAYABLE_CAPTURE_CHROME_PATH=
PLAYABLE_CAPTURE_FFMPEG_PATH=
# Set to true only if using Imagen (separate from Gemini Flash Image)
VERTEX_AI_ENABLED=false
OPENAI_API_KEY=
# Server-side custom endpoints and ComfyUI outputs may reach only public hosts
# by default. Opt in exact, deployment-owned private hostnames only when needed.
# Cloud metadata and link-local addresses remain blocked even when listed.
AI_VIDEO_OUTBOUND_PRIVATE_HOST_ALLOWLIST=

# Studio asset storage
# Leave INCEPT_ASSET_BUCKET empty for local temp mode during development.
# If INCEPT_ASSET_BUCKET is set and the runtime has valid GCP credentials,
# uploads, generated images, and GIF assets will also be stored in GCS.
# Set INCEPT_REQUIRE_GCS_UPLOAD=true only when GCS access is mandatory.
# Optional authenticated MCP automation for the React/FastAPI Video workspace.
# Leave both unset to keep the transport disabled.
VIDEO_STUDIO_MCP_PUBLIC_URL=
VIDEO_STUDIO_MCP_PRINCIPALS=

# -----------------------------------------------------------------------------
# apps/api (FastAPI)
# -----------------------------------------------------------------------------
INTERSIGHT_ENV=development
INTERSIGHT_API_MODE=live
INTERSIGHT_API_HOST=0.0.0.0
INTERSIGHT_API_PORT=8000
INTERSIGHT_INTERNAL_API_KEY=replace-with-a-shared-internal-api-key
CORS_ALLOW_ORIGINS=http://localhost:3000

# GCP / BigQuery
GCP_PROJECT_DEPLOY=ads-bpd-guard-sandbox
GCP_PROJECT_DATA=ads-bpd-guard-china
BQ_WRITE_PROJECT=ads-bpd-guard-sandbox
BQ_READ_PROJECT=ads-bpd-guard-china
BQ_DATASET_SUPPLY_SMB_WRITE=supply_smb
BQ_DATASET_CONFIG=config
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini Enterprise Agent Platform
GOOGLE_CLOUD_PROJECT=ads-bpd-guard-sandbox
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True
GEMINI_MODEL=gemini-2.5-flash

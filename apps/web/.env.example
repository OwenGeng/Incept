# -----------------------------------------------------------------------------
# apps/web (Next.js)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

API_BASE_URL=http://localhost:8000
INCEPT_INTERNAL_API_KEY=replace-with-a-shared-internal-api-key

# Jellyfish AI Video is a separate Vite + FastAPI service, mounted by Next at
# /ai-video and accessed from the browser only through /api/ai-video.
# Set both to the deployed service origins; do not put credentials in the client.
# AI Video is bundled into this Next.js service. Browser calls use the
# same-origin `/api/ai-video` bridge by default.
NEXT_PUBLIC_AI_VIDEO_API_BASE_URL=/api/ai-video
AI_VIDEO_API_BASE_URL=
# Optional when AI Video uses a separate internal-key secret; otherwise the
# existing INCEPT_INTERNAL_API_KEY is forwarded.
AI_VIDEO_INTERNAL_API_KEY=

AUTH_ALLOWLIST_BYPASS=false
AUTH_DEV_SKIP_SIGN_IN=false

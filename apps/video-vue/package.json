{
  "name": "@linglonglab/video-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/nodes/*",
    "packages/tools/*",
    "packages/teams/*"
  ],
  "scripts": {
    "clean:nodes": "node -e \"require('node:fs').rmSync('build/nodes', { recursive: true, force: true })\"",
    "clean:tools": "node -e \"require('node:fs').rmSync('build/tools', { recursive: true, force: true })\"",
    "build:nodes": "pnpm clean:nodes && NODE_ENV=production pnpm --filter './packages/nodes/*' run build",
    "build:tools": "pnpm clean:tools && NODE_ENV=production pnpm --filter './packages/tools/*' run build",
    "build:web": "pnpm --filter '@linglonglab/video-web' build",
    "build": "pnpm build:nodes && pnpm build:web",
    "sync": "node scripts/sync-build.mjs",
    "prepare:incept": "pnpm build && pnpm sync",
    "dev": "pnpm --filter '@linglonglab/video-web' dev",
    "typecheck": "pnpm --filter '@linglonglab/video-*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/postcss-pxtorem": "^6.1.0",
    "postcss": "^8.5.28",
    "postcss-pxtorem": "^6.1.0",
    "typescript": "^7.0.2"
  }
}

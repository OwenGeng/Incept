{
  "name": "incept",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build:video-vue": "pnpm --dir apps/video-vue build",
    "sync:video-vue": "pnpm --dir apps/video-vue sync",
    "prepare:video-vue": "pnpm --dir apps/video-vue prepare:incept",
    "dev:web": "pnpm prepare:video-vue && pnpm --filter @incept/web dev",
    "build:web": "pnpm prepare:video-vue && pnpm --filter @incept/web build",
    "lint:web": "pnpm --filter @incept/web lint",
    "typecheck:web": "pnpm --filter @incept/web exec tsc --noEmit",
    "release:validate": "node scripts/release-manifest.mjs validate"
  }
}

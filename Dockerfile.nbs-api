# =============================================================================
# LinglongLab unified API -- Cloud Run Dockerfile
# Build context: repo root  (docker build -f Dockerfile.nbs-api .)
# =============================================================================
FROM node:24-bookworm-slim AS pi_runtime
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.18.1 --activate
COPY apps/video-vue/ ./apps/video-vue/
RUN pnpm --dir apps/video-vue install --frozen-lockfile --ignore-scripts --prod --filter @linglonglab/video-agent-runtime...
# Import the real SDK at build time; a missing dependency must fail the image.
RUN node --experimental-strip-types --input-type=module -e 'import("./apps/video-vue/apps/agentRuntime/src/nativeRuntime.ts")'

FROM python:3.12-slim-bookworm

WORKDIR /app

COPY --from=pi_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=pi_runtime /app/apps/video-vue /app/apps/video-vue

# System deps:
#   gcc          — for Python C extensions (pydantic-settings, etc.)
#   libgl1       — OpenCV dependency used by rembg
#   libglib2.0-0 — GLib dependency used by rembg / OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg gcc libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY apps/api/app/ ./app/

# Fonts used by both Kakao composition paths. The unified image does not copy
# apps/web, so these must be included explicitly.
COPY apps/web/public/Pretendard/ ./fonts/kakao/
COPY apps/web/public/SpoqaHanSansNeo_all/SpoqaHanSansNeo_TTF_original/ ./fonts/kakao/

# Persistent data dir for SQLite (apps/api/data/incept.db)
RUN mkdir -p /app/data

# Static file dirs for LinglongLab (generated images & uploads)
RUN mkdir -p /app/static/generated /app/static/uploads

ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV INCEPT_PROJECT_ROOT=/app
ENV KAKAO_FONT_DIR=/app/fonts/kakao
ENV PLAYABLE_CAPTURE_FFMPEG_PATH=/usr/bin/ffmpeg

EXPOSE 8080

CMD ["sh", "-c", "python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]

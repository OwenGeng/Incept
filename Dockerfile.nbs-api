# =============================================================================
# NBSpark Unified API (InterSight + Incept) -- Cloud Run Dockerfile
# Build context: repo root  (docker build -f Dockerfile.nbs-api .)
# =============================================================================
FROM python:3.12-slim

WORKDIR /app

# System deps:
#   gcc          — for Python C extensions (pydantic-settings, etc.)
#   libgl1       — OpenCV dependency used by rembg
#   libglib2.0-0 — GLib dependency used by rembg / OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY apps/api/app/ ./app/

# SQL query files loaded at runtime by supply_smb_live.py
COPY sql/ ./sql/

# Persistent data dir for SQLite (apps/api/data/incept.db)
RUN mkdir -p /app/data

# Static file dirs for Incept (generated images & uploads)
RUN mkdir -p /app/static/generated /app/static/uploads

ENV PYTHONUNBUFFERED=1
ENV PORT=8080
# Tells _project_root() in supply_smb_live.py where to look
ENV INTERSIGHT_PROJECT_ROOT=/app

EXPOSE 8080

CMD ["sh", "-c", "python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
